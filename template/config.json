{
  "models": {
    "local": {
      "provider": "openai",
      "model": "qwen2.5-coder:14b",
      "base_url": "http://host.docker.internal:11434",
      "temperature": 0.1,
      "max_tokens": 4096
    },
    "reasoning": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5",
      "temperature": 0.3,
      "max_tokens": 8192
    }
  },
  "task_routing": {
    "default": "local",
    "reasoning": "reasoning"
  }
}